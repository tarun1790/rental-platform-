# =========================================================================
# Rental Platform Environment Configuration
# =========================================================================

# Primary Server Configuration
PORT=3000
NODE_ENV=development

# Redis Cache (Optional - memory fallback active by default)
REDIS_URL=redis://localhost:6379

# n8n Automation Engine
# Point to your local or cloud n8n webhook URL
N8N_WEBHOOK_URL=http://localhost:5678/webhook/scrape-rentals
N8N_INGEST_SECRET=rental_n8n_secret_token_2026

# Exa.ai Neural Search API (Optional)
EXA_API_KEY=

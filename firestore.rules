rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Properties collection: Publicly readable, write restricted to administrators
    match /properties/{propertyId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.admin == true;
      
      match /telemetry/{telemetryId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.token.admin == true;
      }
    }
    
    // Lease applications: Authenticated users can submit and read their own applications
    match /lease_applications/{applicationId} {
      allow create: if true; // Allows anonymous and guest applicants with captcha/rate limiting
      allow read, update: if isAuthenticated() && (resource.data.applicantUid == request.auth.uid || request.auth.token.admin == true);
      allow delete: if isAuthenticated() && request.auth.token.admin == true;
    }
    
    // User profile and saved searches: Owner restricted
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      match /saved_properties/{propertyId} {
        allow read, write: if isOwner(userId);
      }
      
      match /custom_underwriting_models/{modelId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // System analytics and health logs: Admin only
    match /system_telemetry/{logId} {
      allow read, write: if isAuthenticated() && request.auth.token.admin == true;
    }
  }
}
